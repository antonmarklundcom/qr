# Hostinger MySQL connection string.
# Live app (hPanel -> Node.js App -> Environment Variables): use the localhost host
#   mysql://u123_qr:password@localhost:3306/u123_qr
# Local/one-off scripts: enable hPanel -> Databases -> Remote MySQL, whitelist your IP,
# and use the remote host shown there (e.g. srv1724.hstgr.io, or its raw IP if DNS flakes).
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# 32+ character random string used to encrypt the iron-session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-32-char-minimum-random-string"

# Public origin of the deployed app, no trailing slash. Used to build the absolute
# /r/<slug> URL that gets encoded into every printed QR code — changing it after cards
# are printed invalidates them, so set the final domain before the first print run.
APP_URL="http://localhost:3000"

# Salt mixed into the SHA-256 user-agent hash stored on scans. Rotating it only resets
# rough uniqueness bucketing; no personal data is stored either way.
SCAN_HASH_SALT="change-me-too"
